<%- include('partials/header') %>

<%
  const safeCustomer = typeof customer !== 'undefined' && customer ? customer : {};
  const safeBranches = typeof branches !== 'undefined' && Array.isArray(branches) ? branches : [];
  const safeBranchId = typeof branchId !== 'undefined' ? branchId : '';
  const safeCategories = typeof categories !== 'undefined' && Array.isArray(categories) ? categories : [];
  const safeCategory = typeof category !== 'undefined' ? category : '';
  const safeMenu = typeof menu !== 'undefined' && Array.isArray(menu) ? menu : [];
  const safeError = typeof error !== 'undefined' ? error : null;
%>

<section class="hero shop-hero customer-shop-hero">
  <div>
    <span class="eyebrow">Fresh coffee • Fast delivery</span>
    <h1>Đặt cà phê online</h1>
    <p>Chọn món nhanh, lọc danh mục không tải lại trang, dùng điểm giảm giá và theo dõi giỏ hàng ngay bên cạnh.</p>
  </div>

  <div class="point-card customer-point-card">
    <span>Điểm hiện có</span>
    <b><%= Number(safeCustomer.points || 0).toLocaleString('vi-VN') %> điểm</b>
    <small>
      Quy đổi được <%= Number((safeCustomer.points || 0) * 500).toLocaleString('vi-VN') %>đ
    </small>
  </div>
</section>

<div id="toast" class="toast hidden">
  <span id="toastMessage"></span>
  <button type="button" onclick="closeToast()">×</button>
</div>

<% if (safeError) { %>
  <div class="alert"><%= safeError %></div>
<% } %>

<div class="shop-layout">
  <main class="shop-main">
    <section class="card shop-filter-card">
      <div class="filter-top">
        <div>
          <h2>Chọn chi nhánh & danh mục</h2>
          <p class="muted">Đổi chi nhánh sẽ tải lại menu của chi nhánh đó. Lọc danh mục dùng AJAX, không tải lại trang.</p>
        </div>

        <div class="branch-select-box">
          <label for="branchSelect">Chi nhánh</label>
          <select id="branchSelect" name="branch_id">
            <% safeBranches.forEach(b => { %>
              <option value="<%= b.id %>" <%= Number(safeBranchId) === Number(b.id) ? 'selected' : '' %>>
                <%= b.name %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="category-tabs" id="categoryTabs">
        <button
          type="button"
          class="category-tab <%= !safeCategory ? 'active' : '' %>"
          data-category=""
        >
          Tất cả
        </button>

        <% safeCategories.forEach(c => { %>
          <button
            type="button"
            class="category-tab <%= safeCategory === c ? 'active' : '' %>"
            data-category="<%= c %>"
          >
            <%= c %>
          </button>
        <% }) %>
      </div>

      <div class="shop-search-row">
        <input
          type="search"
          id="productSearchInput"
          placeholder="Tìm món theo tên..."
          autocomplete="off"
        >

        <span id="menuCount" class="muted"></span>
      </div>
    </section>

    <form
      method="post"
      action="/customer/order"
      class="shop-order-form"
      id="orderForm"
    >
      <input type="hidden" name="branch_id" id="branchIdInput" value="<%= safeBranchId %>">

      <section class="card products-section">
        <div class="section-title-row">
          <div>
            <h2>Sản phẩm</h2>
            <p class="muted">Bấm “Thêm” để đưa món vào giỏ. Có thể tăng/giảm số lượng ở giỏ hàng.</p>
          </div>

          <div id="menuLoading" class="menu-loading hidden">
            Đang tải...
          </div>
        </div>

        <div id="productGrid" class="customer-product-grid"></div>

        <div id="emptyMenuState" class="empty-state hidden">
          <h2>Không có sản phẩm</h2>
          <p class="muted">Không tìm thấy món phù hợp với danh mục hoặc từ khóa hiện tại.</p>
        </div>
      </section>

      <section class="card delivery-card">
        <h2>Giao hàng & điểm</h2>

        <label for="deliveryAddress">Địa chỉ giao hàng</label>

        <div class="address-box">
          <input
            id="deliveryAddress"
            name="delivery_address"
            value="<%= safeCustomer.address || '' %>"
            readonly
            required
          >

          <button type="button" class="light" onclick="enableAddressEdit()">
            Sửa địa chỉ
          </button>
        </div>

        <label for="usePoints">Dùng điểm giảm giá</label>

        <input
          id="usePoints"
          type="number"
          name="use_points"
          min="0"
          max="<%= safeCustomer.points || 0 %>"
          value="0"
        >

        <small>
          Bạn có <b><%= Number(safeCustomer.points || 0).toLocaleString('vi-VN') %></b> điểm =
          <b><%= Number((safeCustomer.points || 0) * 500).toLocaleString('vi-VN') %>đ</b>.
          1 điểm = 500đ.
        </small>

        <label for="note">Ghi chú cho cửa hàng</label>
        <textarea
          id="note"
          name="note"
          placeholder="Ví dụ: ít đá, giao giờ nghỉ trưa, gọi trước khi giao..."
        ></textarea>

        <div id="orderHiddenInputs"></div>
      </section>
    </form>
  </main>

  <aside class="card cart-card customer-cart-card">
    <div class="cart-header">
      <div>
        <h2>Giỏ hàng</h2>
        <p class="muted">Theo dõi món đã chọn và tổng tiền.</p>
      </div>
    </div>

    <div id="cartItems" class="customer-cart-items muted">
      Chưa chọn sản phẩm
    </div>

    <hr>

    <div class="cart-money-row">
      <span>Tạm tính</span>
      <b id="subtotal">0đ</b>
    </div>

    <div class="cart-money-row">
      <span>Giảm điểm</span>
      <b id="discount">0đ</b>
    </div>

    <div class="cart-money-row final">
      <span>Thanh toán</span>
      <b id="finalTotal">0đ</b>
    </div>

    <button class="primary cart-submit-btn" type="submit" form="orderForm">
      Xác nhận đặt hàng
    </button>

    <p class="muted cart-note">
      Sau khi thanh toán thành công, hệ thống tự cộng điểm theo tỷ lệ 10.000đ = 1 điểm.
    </p>
  </aside>
</div>

<div
  id="initialShopData"
  class="hidden"
  data-menu="<%= encodeURIComponent(JSON.stringify(safeMenu)) %>"
  data-category="<%= encodeURIComponent(safeCategory) %>"
></div>

<script>
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toastMessage');
  const selectedProducts = new Map();

  const initialShopData = document.getElementById('initialShopData');

  let currentMenu = [];
  let currentCategory = '';
  let searchKeyword = '';

  try {
    currentMenu = JSON.parse(decodeURIComponent(initialShopData.dataset.menu || '%5B%5D'));
  } catch (err) {
    currentMenu = [];
  }

  try {
    currentCategory = decodeURIComponent(initialShopData.dataset.category || '');
  } catch (err) {
    currentCategory = '';
  }

  function showToast(message, type = 'success') {
    toast.className = `toast ${type}`;
    toastMessage.textContent = message;

    setTimeout(() => {
      closeToast();
    }, 3500);
  }

  function closeToast() {
    toast.className = 'toast hidden';
  }

  function money(n) {
    return Number(n || 0).toLocaleString('vi-VN') + 'đ';
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function enableAddressEdit() {
    const input = document.getElementById('deliveryAddress');

    input.removeAttribute('readonly');
    input.focus();
  }

  function getProductId(product) {
    return String(product.menu_item_id || product.id || '');
  }

  function normalizeProduct(product) {
    return {
      id: getProductId(product),
      menu_item_id: product.menu_item_id || product.id,
      name: product.name || '',
      category: product.category || 'Khác',
      description: product.description || 'Món ngon tại chi nhánh',
      price: Number(product.price || product.base_price || 0),
      image_url: product.image_url || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=500'
    };
  }

  function filteredMenu() {
    const keyword = searchKeyword.trim().toLowerCase();

    return currentMenu
      .map(normalizeProduct)
      .filter(product => {
        const matchKeyword = !keyword || product.name.toLowerCase().includes(keyword);
        return matchKeyword;
      });
  }

  function setLoading(isLoading) {
    const loading = document.getElementById('menuLoading');

    if (!loading) return;

    if (isLoading) {
      loading.classList.remove('hidden');
    } else {
      loading.classList.add('hidden');
    }
  }

  function renderMenu() {
    const productGrid = document.getElementById('productGrid');
    const emptyMenuState = document.getElementById('emptyMenuState');
    const menuCount = document.getElementById('menuCount');

    const products = filteredMenu();

    menuCount.textContent = products.length ? products.length + ' món' : '0 món';

    if (!products.length) {
      productGrid.innerHTML = '';
      emptyMenuState.classList.remove('hidden');
      return;
    }

    emptyMenuState.classList.add('hidden');

    productGrid.innerHTML = products.map(product => {
      const selected = selectedProducts.get(String(product.id));
      const quantity = selected ? selected.quantity : 0;
      const safeId = encodeURIComponent(product.id);

      return `
        <article class="customer-product-card ${quantity > 0 ? 'selected' : ''}">
          <div class="product-image-wrap">
            <img src="${escapeHtml(product.image_url)}" alt="${escapeHtml(product.name)}">
            <span class="pill">${escapeHtml(product.category)}</span>
          </div>

          <div class="product-info">
            <h3>${escapeHtml(product.name)}</h3>
            <p>${escapeHtml(product.description)}</p>

            <div class="product-bottom">
              <strong>${money(product.price)}</strong>

              ${
                quantity > 0
                  ? `
                    <div class="mini-qty">
                      <button type="button" onclick="decreaseProduct('${safeId}')">−</button>
                      <span>${quantity}</span>
                      <button type="button" onclick="increaseProduct('${safeId}')">+</button>
                    </div>
                  `
                  : `
                    <button
                      type="button"
                      class="add-product-btn"
                      onclick="addProductFromMenu('${safeId}')"
                    >
                      + Thêm
                    </button>
                  `
              }
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  async function loadMenuByCategory(category) {
    const branchId = document.getElementById('branchIdInput').value;

    currentCategory = category || '';

    document.querySelectorAll('.category-tab').forEach(button => {
      button.classList.toggle('active', button.dataset.category === currentCategory);
    });

    setLoading(true);

    try {
      const res = await fetch(
        `/api/customer/menu?branch_id=${encodeURIComponent(branchId)}&category=${encodeURIComponent(currentCategory)}`,
        {
          headers: {
            Accept: 'application/json'
          }
        }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.message || 'Không thể tải danh sách món.');
      }

      currentMenu = Array.isArray(data.menu) ? data.menu : [];

      renderMenu();
    } catch (err) {
      showToast(err.message || 'Không thể lọc danh mục. Vui lòng thử lại.', 'error');
    } finally {
      setLoading(false);
    }
  }

  function addProductFromMenu(encodedId) {
    const id = decodeURIComponent(encodedId);

    const product = currentMenu
      .map(normalizeProduct)
      .find(item => String(item.id) === String(id));

    if (!product) return;

    addProduct(product);
  }

  function addProduct(product) {
    const id = String(product.id);
    const existing = selectedProducts.get(id);

    if (existing) {
      existing.quantity += 1;
    } else {
      selectedProducts.set(id, {
        id,
        name: product.name,
        price: Number(product.price || 0),
        quantity: 1
      });
    }

    renderCart();
    renderMenu();
  }

  function increaseProduct(encodedId) {
    const id = decodeURIComponent(encodedId);
    const product = selectedProducts.get(String(id));

    if (!product) return;

    product.quantity += 1;

    renderCart();
    renderMenu();
  }

  function decreaseProduct(encodedId) {
    const id = decodeURIComponent(encodedId);
    const product = selectedProducts.get(String(id));

    if (!product) return;

    product.quantity -= 1;

    if (product.quantity <= 0) {
      selectedProducts.delete(String(id));
    }

    renderCart();
    renderMenu();
  }

  function removeProduct(encodedId) {
    const id = decodeURIComponent(encodedId);

    selectedProducts.delete(String(id));

    renderCart();
    renderMenu();
  }

  function getSelectedItems() {
    return Array.from(selectedProducts.values()).map(product => ({
      id: product.id,
      name: product.name,
      quantity: Number(product.quantity || 0),
      price: Number(product.price || 0)
    }));
  }

  function renderHiddenInputs() {
    const hiddenInputs = document.getElementById('orderHiddenInputs');

    hiddenInputs.innerHTML = getSelectedItems().map(item => `
      <input type="hidden" name="menu_item_id" value="${escapeHtml(item.id)}">
      <input type="hidden" name="quantity_${escapeHtml(item.id)}" value="${item.quantity}">
    `).join('');
  }

  function renderCart() {
    const cartItems = document.getElementById('cartItems');
    const selectedItems = getSelectedItems();

    if (!selectedItems.length) {
      cartItems.className = 'customer-cart-items muted';
      cartItems.innerHTML = 'Chưa chọn sản phẩm';
    } else {
      cartItems.className = 'customer-cart-items';

      cartItems.innerHTML = selectedItems.map(item => {
        const safeId = encodeURIComponent(item.id);

        return `
          <div class="customer-cart-line">
            <div>
              <b>${escapeHtml(item.name)}</b>
              <span>${money(item.price)} x ${item.quantity}</span>
            </div>

            <div class="cart-line-actions">
              <button type="button" onclick="decreaseProduct('${safeId}')">−</button>
              <strong>${item.quantity}</strong>
              <button type="button" onclick="increaseProduct('${safeId}')">+</button>
              <button type="button" class="remove-btn" onclick="removeProduct('${safeId}')">×</button>
            </div>
          </div>
        `;
      }).join('');
    }

    renderHiddenInputs();
    calc();
  }

  function calc() {
    let subtotal = 0;

    getSelectedItems().forEach(item => {
      subtotal += item.price * item.quantity;
    });

    const usePointsInput = document.getElementById('usePoints');
    const points = Number(usePointsInput.value || 0);
    const maxPoints = Number(usePointsInput.max || 0);

    if (points > maxPoints) {
      usePointsInput.setCustomValidity('Điểm không đủ');
    } else {
      usePointsInput.setCustomValidity('');
    }

    const discount = points * 500;
    const finalTotal = Math.max(0, subtotal - discount);

    document.getElementById('subtotal').textContent = money(subtotal);
    document.getElementById('discount').textContent = money(discount);
    document.getElementById('finalTotal').textContent = money(finalTotal);
  }

  document.getElementById('branchSelect').addEventListener('change', function () {
    const branchId = this.value;

    window.location.href = `/customer?branch_id=${encodeURIComponent(branchId)}`;
  });

  document.querySelectorAll('.category-tab').forEach(button => {
    button.addEventListener('click', function () {
      loadMenuByCategory(this.dataset.category || '');
    });
  });

  document.getElementById('productSearchInput').addEventListener('input', function () {
    searchKeyword = this.value;

    renderMenu();
  });

  document.getElementById('usePoints').addEventListener('input', calc);
  document.getElementById('usePoints').addEventListener('change', calc);

  const orderForm = document.getElementById('orderForm');

  orderForm.addEventListener('submit', function (e) {
    const selectedItems = getSelectedItems();
    const deliveryAddress = document.getElementById('deliveryAddress');
    const usePointsInput = document.getElementById('usePoints');

    const points = Number(usePointsInput.value || 0);
    const maxPoints = Number(usePointsInput.max || 0);

    document.querySelectorAll('.input-error').forEach(input => {
      input.classList.remove('input-error');
    });

    if (selectedItems.length === 0) {
      e.preventDefault();
      showToast('Vui lòng chọn ít nhất 1 sản phẩm.', 'error');
      return;
    }

    for (const item of selectedItems) {
      if (!Number.isInteger(item.quantity) || item.quantity <= 0) {
        e.preventDefault();
        showToast('Số lượng sản phẩm phải lớn hơn 0.', 'error');
        return;
      }
    }

    if (!deliveryAddress.value.trim()) {
      e.preventDefault();
      deliveryAddress.classList.add('input-error');
      showToast('Vui lòng nhập địa chỉ giao hàng.', 'error');
      return;
    }

    if (deliveryAddress.value.trim().length < 5) {
      e.preventDefault();
      deliveryAddress.classList.add('input-error');
      showToast('Địa chỉ giao hàng phải có ít nhất 5 ký tự.', 'error');
      return;
    }

    if (points < 0) {
      e.preventDefault();
      usePointsInput.classList.add('input-error');
      showToast('Số điểm sử dụng không được nhỏ hơn 0.', 'error');
      return;
    }

    if (points > maxPoints) {
      e.preventDefault();
      usePointsInput.classList.add('input-error');
      showToast('Bạn không đủ điểm để sử dụng.', 'error');
      return;
    }
  });

  const addressForm = document.getElementById('addressForm');

  addressForm.addEventListener('submit', function (e) {
    const defaultAddress = document.getElementById('defaultAddress');

    defaultAddress.classList.remove('input-error');

    if (!defaultAddress.value.trim()) {
      e.preventDefault();
      defaultAddress.classList.add('input-error');
      showToast('Địa chỉ mặc định không được để trống.', 'error');
      return;
    }

    if (defaultAddress.value.trim().length < 5) {
      e.preventDefault();
      defaultAddress.classList.add('input-error');
      showToast('Địa chỉ mặc định phải có ít nhất 5 ký tự.', 'error');
    }
  });

  const params = new URLSearchParams(window.location.search);

  if (params.get('success')) {
    showToast(params.get('success'), 'success');
  }

  if (params.get('error')) {
    showToast(params.get('error'), 'error');
  }

  renderMenu();
  renderCart();
</script>

<style>
  /* =========================
   GLOBAL
========================= */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, Arial, Helvetica, sans-serif;
  background: #f6f0e8;
  color: #2b2018;
}

a {
  color: #6f4327;
  font-weight: 800;
}

input,
select,
textarea {
  border: 1px solid #d6c7b8;
  border-radius: 12px;
  padding: 11px;
  background: #fff;
  max-width: 100%;
  font-family: inherit;
}

textarea {
  min-height: 76px;
}

button {
  border: 0;
  background: #6f4327;
  color: #fff;
  padding: 11px 15px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 800;
  font-family: inherit;
}

button:hover,
.btn:hover {
  filter: brightness(1.08);
}

.primary {
  background: #9a4d17;
  font-size: 16px;
}

.danger {
  background: #ad3434;
}

.btn {
  color: #fff;
  background: #9a623a;
  text-decoration: none;
  border-radius: 999px;
  padding: 8px 13px;
  display: inline-block;
  font-weight: 700;
}

.btn.light {
  background: #d8c1aa;
  color: #3b2517;
}

.container {
  max-width: 1280px;
  margin: 28px auto;
  padding: 0 18px;
}

footer {
  text-align: center;
  padding: 30px;
  color: #7b6d62;
}

.center {
  text-align: center;
}

.right {
  text-align: right;
}

.muted {
  color: #7b6d62;
}

/* =========================
   NAVBAR
========================= */

.nav {
  position: sticky;
  top: 0;
  z-index: 5;
  background: linear-gradient(90deg, #2f1c12, #6f4327);
  color: #fff;
  display: flex;
  gap: 16px;
  justify-content: space-between;
  align-items: center;
  padding: 14px 28px;
  box-shadow: 0 4px 18px #0003;
}

.brand {
  font-size: 22px;
  font-weight: 900;
  white-space: nowrap;
}

.top-meta {
  display: flex;
  gap: 10px;
  align-items: center;
  font-size: 13px;
  color: #f6dfc9;
}

.top-meta span {
  background: #ffffff1f;
  border: 1px solid #ffffff2e;
  border-radius: 999px;
  padding: 6px 10px;
}

.links {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.links a {
  color: #fff;
  background: #9a623a;
  text-decoration: none;
  border-radius: 999px;
  padding: 8px 13px;
  display: inline-block;
  font-weight: 700;
}

/* =========================
   PAGE HEADER
========================= */

.page-head {
  background: #fff;
  border: 1px solid #eaded2;
  border-radius: 24px;
  padding: 26px;
  margin-bottom: 18px;
  box-shadow: 0 10px 28px #5c2e120e;
}

.page-head h1 {
  margin: 8px 0;
  color: #3b2517;
}

.page-head p {
  margin: 0;
  color: #7b6d62;
}

.eyebrow {
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffd9ad;
  font-weight: 900;
}

/* =========================
   ALERTS
========================= */

.alert {
  background: #ffe0e0;
  border: 1px solid #ff9b9b;
  padding: 12px;
  border-radius: 14px;
  color: #8a1d1d;
  margin: 12px 0;
}

.success {
  background: #e3f7e8;
  border: 1px solid #89d69d;
  padding: 14px;
  border-radius: 14px;
  margin: 12px 0;
}

/* =========================
   LAYOUT
========================= */

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 16px;
}

.two {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 18px;
  align-items: start;
}

.card {
  background: #fff;
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 10px 28px #5c2e120e;
  margin: 14px 0;
  border: 1px solid #eaded2;
}

.cards .card b {
  font-size: 30px;
  color: #6f4327;
}

.form-inline {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: end;
}

.toolbar {
  position: sticky;
  top: 72px;
  z-index: 3;
}

/* =========================
   SECTION HEADER
========================= */

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.section-head h2 {
  margin: 6px 0;
}

.section-head p {
  margin: 0;
  color: #7b6d62;
}

/* =========================
   TABLE
========================= */

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 10px 28px #5c2e120e;
  margin: 16px 0;
}

th,
td {
  padding: 11px;
  border-bottom: 1px solid #eee;
  text-align: left;
  vertical-align: top;
}

th {
  background: #efe3d7;
}

.badge,
.pill {
  background: #f0d7bd;
  color: #6f4327;
  border-radius: 999px;
  padding: 5px 10px;
  font-weight: 800;
  display: inline-block;
}

.thumb {
  width: 76px;
  height: 56px;
  object-fit: cover;
  border-radius: 12px;
}

/* =========================
   EMPTY STATE
========================= */

.empty-state {
  text-align: center;
  padding: 42px 24px;
}

.empty-state h2 {
  margin-top: 0;
  color: #6f4327;
}

.empty-state p {
  margin-bottom: 0;
}

.empty-state .btn {
  margin-top: 10px;
}

.empty-cell {
  text-align: center;
  padding: 28px;
  color: #8a735f;
  font-weight: 600;
}

/* =========================
   HERO / CUSTOMER HOME
========================= */

.hero {
  border-radius: 30px;
  padding: 46px;
  background:
    linear-gradient(120deg, #3b2517cc, #8a5a36a8),
    url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1400');
  background-size: cover;
  background-position: center;
  color: #fff;
  margin-bottom: 18px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
}

.hero h1 {
  font-size: 48px;
  margin: 8px 0;
}

.point-card {
  background: #fff;
  color: #3b2517;
  border-radius: 22px;
  padding: 18px;
  min-width: 210px;
  box-shadow: 0 14px 40px #0003;
}

.point-card b {
  display: block;
  font-size: 34px;
  color: #8a3f14;
}

.point-big b {
  font-size: 36px;
  color: #8a3f14;
}

/* =========================
   PRODUCT / SHOP
========================= */

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
  gap: 18px;
}

.product-card {
  background: #fff;
  border: 1px solid #eaded2;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 8px 24px #5c2e120d;
  transition: 0.2s;
}

.product-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 34px #5c2e1220;
}

.product-card img {
  width: 100%;
  height: 165px;
  object-fit: cover;
}

.product-info {
  padding: 14px;
}

.product-info h3 {
  margin: 9px 0 5px;
}

.product-info p {
  color: #7b6d62;
  min-height: 40px;
}

.product-card strong {
  color: #8a3f14;
  font-size: 19px;
}

.buy-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
  margin-top: 10px;
}

.buy-row .qty {
  width: 80px;
}

/* =========================
   POS PRODUCT MINI
========================= */

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 10px;
}

.product-mini {
  display: grid;
  grid-template-columns: 70px 1fr 22px 70px;
  gap: 10px;
  align-items: center;
  background: #fdfbf8;
  border: 1px solid #eaded2;
  padding: 10px;
  border-radius: 14px;
}

.product-mini img {
  width: 70px;
  height: 54px;
  object-fit: cover;
  border-radius: 10px;
}

/* =========================
   CART / CHECKOUT
========================= */

.cart-card {
  position: sticky;
  top: 150px;
}

.cart-card hr {
  border: 0;
  border-top: 1px dashed #d6c7b8;
}

.address-box {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

.checkout-card {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  background: #fff;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 10px 28px #5c2e120e;
}

.total-box {
  background: #fff4e6;
  border: 1px solid #ead0ae;
  border-radius: 18px;
  padding: 18px;
  min-width: 240px;
}

.total-box span {
  display: block;
  color: #795638;
}

.total-box b {
  font-size: 30px;
  color: #9a4d17;
}

/* =========================
   THANK YOU PAGE
========================= */

.thank {
  text-align: center;
  background: #fff;
  border-radius: 28px;
  padding: 56px;
  box-shadow: 0 10px 28px #5c2e120e;
}

.actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 18px;
}

.actions-cell {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.actions-cell form {
  margin: 0;
}

/* =========================
   DASHBOARD / CHARTS
========================= */

.barline {
  display: grid;
  grid-template-columns: 150px 1fr 45px;
  gap: 8px;
  align-items: center;
  margin: 10px 0;
}

.barline b {
  height: 12px;
  background: #9a623a;
  border-radius: 999px;
  display: block;
  min-width: 8px;
}

.barline em {
  font-style: normal;
  color: #6f4327;
  font-weight: 800;
}

.chart-bars {
  height: 250px;
  display: flex;
  gap: 10px;
  align-items: end;
  overflow: auto;
  padding: 8px;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: end;
  gap: 5px;
  min-width: 55px;
}

.bar-col span,
.revenue-bar {
  width: 34px;
  background: linear-gradient(#b07745, #6f4327);
  border-radius: 10px 10px 2px 2px;
  display: block;
}

.bar-col small {
  font-size: 12px;
  color: #7b6d62;
}

.bar-col b {
  font-size: 11px;
  color: #6f4327;
}

/* =========================
   DONUT CHART
========================= */

.donut {
  display: grid;
  place-items: center;
  margin-top: 12px;
}

.donut-chart,
.donut div {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  position: relative;
}

.donut-chart::after,
.donut div::after {
  content: '';
  position: absolute;
  inset: 42px;
  background: #fff;
  border-radius: 50%;
}

.donut-row {
  display: grid;
  grid-template-columns: 16px 1fr 50px 70px;
  align-items: center;
  gap: 8px;
  margin: 8px 0;
}

.dot {
  width: 12px;
  height: 12px;
  background: #9a623a;
  border-radius: 50%;
}

.donut-row em {
  font-style: normal;
  font-weight: 900;
  color: #6f4327;
}

/* =========================
   MENU TABS
========================= */

.menu-tabs-card {
  padding: 10px;
  margin-bottom: 18px;
}

.menu-tabs {
  display: flex;
  gap: 10px;
  background: #f6efe7;
  border: 1px solid rgba(111, 78, 55, 0.12);
  padding: 8px;
  border-radius: 18px;
}

.tab-btn {
  flex: 1;
  border: 0;
  cursor: pointer;
  padding: 13px 18px;
  border-radius: 14px;
  background: transparent;
  color: #7a5a43;
  font-weight: 800;
  transition: 0.2s ease;
}

.tab-btn:hover {
  background: rgba(111, 78, 55, 0.08);
}

.tab-btn.active {
  background: linear-gradient(135deg, #6f4e37, #a47148);
  color: #fff;
  box-shadow: 0 10px 24px rgba(111, 78, 55, 0.22);
}

.tab-panel {
  display: none;
}

.tab-panel.active {
  display: block;
  animation: tabFade 0.2s ease;
}

@keyframes tabFade {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================
   LOOKUP RESULT
========================= */

.lookup-result {
  margin-top: 14px;
}

/* =========================
   TOAST / POPUP MESSAGE
========================= */

.toast {
  position: fixed;
  top: 24px;
  right: 24px;
  min-width: 280px;
  max-width: 420px;
  padding: 14px 18px;
  border-radius: 14px;
  color: #fff;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  animation: toastSlideIn 0.25s ease;
}

.toast.success {
  background: #2f8f46;
}

.toast.error {
  background: #b93232;
}

.toast.warning {
  background: #d68b12;
}

.toast button {
  border: none;
  background: transparent;
  color: #fff;
  font-size: 22px;
  cursor: pointer;
  padding: 0;
}

.hidden {
  display: none !important;
}

.input-error {
  border: 1px solid #b93232 !important;
  background: #fff2f2 !important;
}

.field-error {
  color: #b93232;
  font-size: 13px;
  font-weight: 700;
  margin-top: 4px;
}

@keyframes toastSlideIn {
  from {
    opacity: 0;
    transform: translateX(30px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* =========================
   LOGIN / REGISTER PAGE
========================= */

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 28px;
  background:
    linear-gradient(115deg, rgba(43, 27, 18, 0.82), rgba(111, 63, 34, 0.72)),
    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1600') center / cover;
  color: #2b1b12;
}

.login-shell {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  max-width: 1080px;
  width: 100%;
  border-radius: 34px;
  overflow: hidden;
  box-shadow: 0 24px 70px rgba(68, 38, 18, 0.18);
  background: #fffaf3;
}

.login-hero {
  padding: 52px;
  background: linear-gradient(150deg, #3a2317, #7a4324);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 560px;
}

.login-hero h1 {
  font-size: 46px;
  line-height: 1.05;
  margin: 0 0 16px;
  letter-spacing: -0.05em;
}

.login-hero p {
  color: #f8e4cd;
  line-height: 1.7;
}

.login-hero .eyebrow {
  display: inline-flex;
  width: max-content;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.18);
  font-weight: 900;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #fff;
}

.login-card {
  padding: 46px;
  background: #fffaf3;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 0;
  box-shadow: none;
  margin: 0;
}

.login-card h1 {
  margin: 0 0 8px;
  font-size: 34px;
  letter-spacing: -0.04em;
}

.login-card p,
.login-card small {
  color: #856b5a;
}

.login-card label {
  display: block;
  margin: 14px 0 7px;
  font-weight: 850;
}

.login-card input,
.login-card textarea {
  width: 100%;
  border: 1px solid #e1cdb7;
  background: #fff;
  color: #2b1b12;
  border-radius: 15px;
  padding: 13px 14px;
  font: inherit;
  outline: none;
  margin: 0;
}

.login-card textarea {
  min-height: 92px;
}

.login-card input:focus,
.login-card textarea:focus {
  border-color: #b97948;
  box-shadow: 0 0 0 4px rgba(169, 107, 60, 0.13);
}

.login-card button,
.login-card .btn {
  margin-top: 18px;
  border: 0;
  border-radius: 16px;
  padding: 14px 18px;
  background: linear-gradient(135deg, #6f3f22, #a96b3c);
  color: #fff;
  font-weight: 950;
  cursor: pointer;
  box-shadow: 0 12px 24px rgba(111, 63, 34, 0.22);
  text-decoration: none;
  text-align: center;
}

.login-card a {
  color: #6f3f22;
  font-weight: 900;
}

.stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 28px;
}

.stat-row div {
  padding: 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.13);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.stat-row b {
  font-size: 24px;
  display: block;
}

/* =========================
   INVOICE PAGE
========================= */

.invoice-body {
  background: #f7efe4;
  padding: 20px;
}

.invoice {
  max-width: 860px;
  margin: 30px auto;
  padding: 36px;
  border-radius: 28px;
  background: #fffdf8;
  box-shadow: 0 20px 60px rgba(68, 38, 18, 0.14);
  border: 1px solid #ead9c5;
  color: #2b1b12;
  font-family: Inter, Arial, Helvetica, sans-serif;
}

.invoice h1 {
  text-align: center;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
  font-size: 28px;
}

.invoice h2 {
  color: #6f3f22;
}

.invoice hr {
  border: 0;
  border-top: 1px dashed #d6c7b8;
  margin: 18px 0;
}

.invoice-meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  color: #856b5a;
}

.receipt-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 18px 0;
  border: 1px solid #ead9c5;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: none;
  font-size: 14px;
}

.receipt-table th,
.receipt-table td {
  padding: 12px;
  border-bottom: 1px solid #ead9c5;
  text-align: left;
}

.receipt-table th {
  background: #3a2317;
  color: #fff;
}

.receipt-table tr:last-child td {
  border-bottom: 0;
}

.words {
  margin-top: 26px;
  color: #856b5a;
  font-style: italic;
}

.no-print {
  margin-top: 22px;
}

.invoice .btn {
  background: #9a623a;
}

.invoice button {
  background: #6f4327;
}

/* =========================
   PRINT
========================= */

@media print {
  .no-print {
    display: none !important;
  }

  .invoice-body {
    background: #fff;
    padding: 0;
  }

  .invoice {
    box-shadow: none;
    margin: 0;
    border: 0;
    max-width: none;
    border-radius: 0;
  }
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {
  .two {
    grid-template-columns: 1fr;
  }

  .cart-card {
    position: static;
  }

  .nav {
    align-items: flex-start;
    flex-direction: column;
  }

  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero h1 {
    font-size: 34px;
  }

  .checkout-card {
    flex-direction: column;
  }

  table {
    display: block;
    overflow: auto;
  }

  .product-mini {
    grid-template-columns: 60px 1fr;
  }
}

@media (max-width: 820px) {
  .login-shell {
    grid-template-columns: 1fr;
  }

  .login-hero {
    min-height: auto;
    padding: 30px;
  }

  .login-card {
    padding: 30px;
  }

  .stat-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .toast {
    left: 16px;
    right: 16px;
    top: 16px;
    min-width: auto;
    max-width: none;
  }

  .page-head {
    padding: 20px;
  }

  .thank {
    padding: 34px 20px;
  }

  .invoice {
    padding: 22px;
  }

  .invoice-meta {
    flex-direction: column;
    gap: 6px;
  }
}
.invoice {
  position: relative;
  overflow: hidden;
}

.invoice-brand {
  text-align: center;
  margin-bottom: 10px;
}

.invoice-brand h2 {
  margin: 0;
  font-size: 24px;
  letter-spacing: 1px;
  font-weight: 900;
}

.invoice-brand p {
  margin: 4px 0 10px;
  font-size: 13px;
  color: #666;
}

.invoice-watermark {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-28deg);
  font-size: 48px;
  font-weight: 900;
  letter-spacing: 4px;
  color: rgba(0, 0, 0, 0.05);
  white-space: nowrap;
  pointer-events: none;
  z-index: 0;
}

.invoice > *:not(.invoice-watermark) {
  position: relative;
  z-index: 1;
}

.kitchen-note {
  margin: 12px 0;
  padding: 10px 12px;
  border: 1px dashed #111;
  border-radius: 8px;
  background: #fff8dc;
}

.kitchen-note p {
  margin: 6px 0 0;
  font-weight: 600;
  white-space: pre-line;
}

.customer-orders-card h2 {
    margin-top: 0;
    margin-bottom: 6px;
  }

  .orders-title-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .orders-title-row p {
    margin: 0;
  }

  .table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .order-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .inline-cancel-form {
    display: inline-block;
    margin: 0;
  }

  .danger {
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #dc2626;
    color: #fff;
    font-weight: 700;
  }

  .danger:hover {
    background: #b91c1c;
  }

  .small-danger {
    padding: 8px 10px;
    font-size: 13px;
  }

  .danger-badge {
    background: #fee2e2;
    color: #991b1b;
  }

  .success-badge {
    background: #dcfce7;
    color: #166534;
  }

  .warning-badge {
    background: #fef3c7;
    color: #92400e;
  }

  @media (max-width: 720px) {
    .order-actions {
      display: grid;
      gap: 6px;
    }

    .order-actions .btn,
    .order-actions button {
      width: 100%;
      text-align: center;
    }
  }

  .customer-shop-hero {
    align-items: stretch;
    gap: 20px;
  }

  .customer-point-card {
    display: grid;
    gap: 6px;
    min-width: 220px;
  }

  .customer-point-card span,
  .customer-point-card small {
    opacity: 0.8;
  }

  .shop-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 18px;
    align-items: start;
  }

  .shop-main {
    min-width: 0;
    display: grid;
    gap: 16px;
  }

  .shop-filter-card,
  .products-section,
  .delivery-card,
  .address-update-card,
  .customer-cart-card {
    padding: 18px;
  }

  .filter-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .filter-top h2,
  .products-section h2,
  .delivery-card h2,
  .address-update-card h2,
  .customer-cart-card h2 {
    margin-top: 0;
    margin-bottom: 6px;
  }

  .filter-top p,
  .section-title-row p,
  .cart-header p {
    margin: 0;
  }

  .branch-select-box {
    min-width: 240px;
  }

  .category-tabs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    margin-bottom: 14px;
  }

  .category-tab {
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 9px 14px;
    background: #fff;
    cursor: pointer;
    white-space: nowrap;
    font-weight: 700;
  }

  .category-tab.active,
  .category-tab:hover {
    background: #111827;
    color: #fff;
    border-color: #111827;
  }

  .shop-search-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .shop-search-row input {
    flex: 1;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .menu-loading {
    padding: 8px 10px;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    font-weight: 700;
    white-space: nowrap;
  }

  .hidden {
    display: none !important;
  }

  .customer-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
  }

  .customer-product-card {
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #fff;
